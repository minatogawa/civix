# Flask Configuration
FLASK_APP=app.app:app
FLASK_ENV=development
SECRET_KEY=your-secret-key-here

# Database Configuration
DATABASE_URL=postgresql://username:password@localhost:5432/civix_db
POSTGRES_USER=civix_user
POSTGRES_PASSWORD=your_db_password
POSTGRES_DB=civix_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_WEBHOOK_URL=https://yourdomain.com/webhook

# OpenAI Configuration (Optional)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-3.5-turbo

# Application Settings
DEBUG=True

# Logging Configuration
# Available levels: TRACE, DEBUG, INFO, SUCCESS, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
# Set to development for colored logs, production for JSON structured logs
LOG_FORMAT=development
# Enable/disable specific log categories
LOG_REQUESTS=true
LOG_DATABASE=true
LOG_TELEGRAM=true
# Log file retention in days
LOG_RETENTION_DAYS=30
LOG_ERROR_RETENTION_DAYS=90
